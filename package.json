{
  "name": "wydot-school-safety-dashboard",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --mode research",
    "dev:public": "vite --mode public",
    "build": "tsc --noEmit && vite build && node scripts/audit-release.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "audit:data": "tsx scripts/audit-data.ts",
    "audit:release": "node scripts/audit-release.mjs"
  },
  "dependencies": {
    "echarts": "^6.0.0",
    "leaflet": "1.9.4",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-leaflet": "^5.0.0",
    "react-router-dom": "^7.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/geojson": "^7946.0.16",
    "@types/leaflet": "^1.9.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "csv-parse": "^7.0.3",
    "tsx": "^4.0.0",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vitest": "^5.1.0"
  }
}
